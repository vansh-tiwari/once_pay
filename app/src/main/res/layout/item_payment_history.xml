<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_item_bg"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Avatar Initials -->
        <TextView
            android:id="@+id/tvHistoryAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/zoom_pill_bg"
            android:backgroundTint="@color/accent_emerald_subtle"
            android:gravity="center"
            android:text="M"
            android:textColor="@color/accent_emerald"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHistoryPayee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Merchant Name"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvHistoryDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 Sep, 14:30"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Amount Badge if any -->
        <TextView
            android:id="@+id/tvHistoryAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹500"
            android:textColor="@color/accent_emerald"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

    </LinearLayout>

    <!-- Sub row: VPA & Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tvHistoryVpa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="merchant@upi"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="middle"/>

        <!-- Copy Chip -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHistoryCopy"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="32dp"
            android:minWidth="0dp"
            android:background="@drawable/chip_copy_bg"
            android:text="Copy ID"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp"/>

        <!-- Pay Again Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHistoryPayAgain"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="32dp"
            android:minWidth="0dp"
            android:background="@drawable/scan_btn_bg"
            android:text="Pay Again"
            android:textColor="@color/accent_emerald"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:textAllCaps="false"/>

    </LinearLayout>

</LinearLayout>
