<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UltraWideCam" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#4488FF</item>
        <item name="colorPrimaryVariant">#2266DD</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#44FF88</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#0A0A0A</item>
    </style>

    <style name="GlassBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/GlassBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#161822</item>
    </style>

    <style name="GlassBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
